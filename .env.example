# --- JWT / Auth ---
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
DATABASES_DSN=postgresql+asyncpg://user:password@localhost:5432/db_name

# --- Redis ---
REDIS_DSN=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=300

# --- PostgreSQL (только для compose, в Settings не читаются) ---
POSTGRES_USER=cost_accounting
POSTGRES_PASSWORD=твой_пароль
POSTGRES_DB=cost_accounting
